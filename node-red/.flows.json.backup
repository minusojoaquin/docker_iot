    {
        "id": "bb8d72bc262c337c",
        "type": "function",
        "z": "dc5a20a93ed2c368",
        "name": "Teclado",
        "func": "var opts = {\n    reply_markup: JSON.stringify({\n        keyboard: [\n            ['Temperatura'],],\n        'resize_keyboard': true,\n        'one_time_keyboard': false\n    })\n};\n\nmsg.error = false;\nmsg.payload.content = 'Bienvenido';\nmsg.payload.options = opts;\nmsg.payload.type = \"message\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 400,
        "wires": [
            [
                "cd0aaadbfa6e6d51"
            ]
        ]
    },
    {
        "id": "11f06944f681562a",
        "type": "switch",
        "z": "dc5a20a93ed2c368",
        "name": "",
        "property": "payload",
        "propertyType": "msg",
        "rules": [
            {
                "t": "eq",
                "v": "Temperatura",
                "vt": "str"
            }
