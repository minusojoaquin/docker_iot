    {
        "id": "5fd36bbba997f886",
        "type": "function",
        "z": "dc5a20a93ed2c368",
        "name": "function 1",
        "func": "var temp = Math.trunc(Math.random() * 10) + 15\nvar hum = Math.trunc(Math.random() * 20) + 40\nmsg.payload = {\n    \"temperatura\": temp,\n    \"humedad\": hum\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
