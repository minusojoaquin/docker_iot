    {
        "id": "958214b18b5a4633",
        "type": "function",
        "z": "dc5a20a93ed2c368",
        "name": "function 3",
        "func": "\nconst d = new Date(msg.payload[0]._time);\nmsg.payload = {\n    chatId: msg.originalMessage.chat.id,\n    type: 'message',\n    content: \"temperatura actual\\n\" + parseFloat(parseFloat(\n        msg.payload[0]._value).toFixed(2)).toLocaleString(\n            \"es-AR\") + \" °C\\nmedido a las \" + d.toLocaleTimeString(\n                'es-AR', { timeZone: 'America/Argentina/Buenos_Aires' }) + \" h\"\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 500,
        "wires": [
            [
                "1815271607cae7db",
                "cd0aaadbfa6e6d51"
            ]
        ]
    },
