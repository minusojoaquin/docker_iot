    {
        "id": "func_query_db",
        "type": "function",
        "z": "7410ba4844826a93",
        "name": "Query SQL",
        "func": "msg.topic = \"SELECT temperatura, humedad FROM mediciones ORDER BY id DESC LIMIT 1;\";\nreturn msg;",
        "outputs": 1,
        "x": 330,
        "y": 320,
        "wires": [
