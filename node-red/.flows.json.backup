        "type": "mysql",
        "z": "7410ba4844826a93",
        "mydb": "",
        "name": "DB Sensores",
        "x": 490,
        "y": 320,
        "wires": [
            [
                "func_parse_data"
            ]
        ]
    },
    {
        "id": "func_parse_data",
        "type": "function",
        "z": "7410ba4844826a93",
        "name": "Separar Variables",
        "func": "if(msg.payload && msg.payload.length > 0) {\n    var t = msg.payload[0].temperatura;\n    var h = msg.payload[0].humedad;\n    return [{payload: t}, {payload: h}];\n}\nreturn [null, null];",
        "outputs": 2,
        "x": 670,
        "y": 320,
        "wires": [
            [
                "gauge_temp"
            ],
            [
                "gauge_hum"
            ]
