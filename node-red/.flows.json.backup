    {
        "id": "fba45eeb71f25d93",
        "type": "influxdb in",
        "z": "dc5a20a93ed2c368",
        "influxdb": "637e7ea88480d0e9",
        "name": "",
        "query": "from(bucket: \"SensoresRemotos\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"mediciones\")\n  |> filter(fn: (r) => r[\"_field\"] == \"temperatura\")\n  |> last()",
        "rawOutput": false,
        "precision": "",
        "retentionPolicy": "",
        "org": "Joa Organizacion",
        "x": 560,
        "y": 500,
        "wires": [
            [
                "958214b18b5a4633"
            ]
        ]
    },
    {
        "id": "8bb2906744ba0ed5",
        "type": "telegram receiver",
